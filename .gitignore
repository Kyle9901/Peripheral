# ESP-IDF / CMake 构建产物
/build/
/build-*/
/managed_components/

# 本机缓存
/.cache/

# ESP-IDF 自动生成的配置；可复现配置保存在 sdkconfig.defaults
/sdkconfig
/sdkconfig.old
/sdkconfig.*
!/sdkconfig.defaults

# 本机 IDE / Agent 配置
/.claude/settings.local.json
/.vscode/
/.idea/

# 生产私钥不得提交到仓库
*.key
*.p12
*.pfx

# 常见临时文件
*.log
*.tmp
*.swp
*~
.DS_Store
Thumbs.db
